# ==========================================================
# nginx/default.conf.template
#
# Day la TEMPLATE, khong phai file config that. Image nginx:1.27 chinh thuc
# tu dong quet moi file trong /etc/nginx/templates/*.template luc container
# khoi dong, chay envsubst de thay ${BACKEND_HOST} / ${BACKEND_PORT} bang
# gia tri bien moi truong THAT (dat trong Dockerfile hoac docker-compose.yml),
# roi ghi ket qua ra /etc/nginx/conf.d/default.conf truoc khi nginx start.
#
# Ly do dung reverse proxy thay vi de FE goi thang toi backend:
#  - Trinh duyet chi thay 1 origin DUY NHAT (vd http://localhost:85) ->
#    KHONG CON VAN DE CORS gi ca (khong can ALLOWED_ORIGINS whitelist phuc tap
#    nhu da cau hinh o backend SecurityConfig).
#  - Cookie httpOnly "refresh_token" (path=/api/auth, xem SEC-06) hoat dong
#    dung vi request toi /api/auth/refresh van la same-origin voi trang FE.
# ==========================================================

server {
    listen 85;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---- Reverse proxy toi Backend Spring Boot ----
    # BACKEND_HOST / BACKEND_PORT duoc thay the boi envsubst luc container start.
    # Trong docker-compose cung dev-network, BACKEND_HOST thuong la TEN SERVICE
    # (vd "noted-backend"), Docker DNS noi bo se tu resolve sang IP container.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Dam bao Set-Cookie tu backend (refresh_token httpOnly) duoc forward
        # dung path, khong bi nginx tu y doi domain/path cua cookie.
        proxy_cookie_path /api/auth /api/auth;

        # Auto-save goi API lien tuc (debounce 1.3s) - khong de proxy buffer
        # lam cham phan hoi, dam bao trang thai "Da luu" cap nhat tuc thi.
        proxy_buffering off;
    }

    # Luong dang nhap Google OAuth2 (Spring Security tu dong xu ly cac path nay)
    location /oauth2/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/oauth2/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /login/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/login/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- SPA fallback ----
    # Moi route phia client (React Router kieu client-side, neu co) khong khop
    # file tinh nao se duoc tra ve index.html, tranh loi 404 khi F5 giua route.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---- Cache tai nguyen tinh ----
    location ~* \.(?:js|css|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
                text/xml application/xml text/javascript;
}
