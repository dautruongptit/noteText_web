# ==========================================================
# Bien dung khi BUILD (Vite bake vao bundle tinh, dung cho lenh `pnpm dev`
# hoac `pnpm build` chay TRUC TIEP tren may, KHONG qua Docker/nginx proxy)
# ==========================================================

# De trong neu chay qua Docker + nginx reverse proxy (khuyen nghi - xem
# nginx/default.conf.template): FE se tu goi API bang duong dan tuong doi.
#
# Dat gia tri nay khi chay `pnpm dev` (vite dev server, port 5175) va muon
# goi THANG toi backend dang chay rieng tren may (khong qua nginx):
VITE_API_BASE_URL=http://localhost:8085

# ==========================================================
# Bien dung khi CONTAINER KHOI DONG (chi co tac dung trong Docker, nginx
# doc qua envsubst - xem Dockerfile va nginx/default.conf.template)
# ==========================================================
BACKEND_HOST=noted-backend
BACKEND_PORT=8085
