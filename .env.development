# ==========================================================
# .env.development — Frontend Noted
#
# Vite TU DONG nap file nay khi chay `pnpm dev` (mode "development"), khong
# can cau hinh gi them trong vite.config.ts. Chi anh huong bien VITE_* - duoc
# "bake" vao bundle luc build/dev-serve (xem src/config/env.ts).
# ==========================================================

# Dev: pnpm dev KHONG chay qua nginx reverse proxy (khac Docker/production) -
# phai goi THANG toi backend, nen can dia chi tuyet doi. Khop dung port
# SERVER_PORT=8085 cua backend (xem .env.development phia backend).
VITE_API_BASE_URL=http://localhost:8085
