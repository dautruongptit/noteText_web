# ==========================================================
# .env.production — Frontend Noted
#
# Vite TU DONG nap file nay khi chay `pnpm build` (mode "production").
# ==========================================================

# De TRONG (khuyen nghi) khi deploy qua Docker + nginx reverse proxy (xem
# nginx/default.conf.template) - FE se goi API bang duong dan TUONG DOI
# ("/api/...", cung origin voi chinh no qua nginx port 85), tranh hoan toan
# van de CORS. KHONG can sua file nay khi doi domain/server - chi can doi
# bien BACKEND_HOST/BACKEND_PORT luc container khoi dong (xem docker-compose.yml).
VITE_API_BASE_URL=
